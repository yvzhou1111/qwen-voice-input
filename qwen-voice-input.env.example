# Copy to ~/.config/qwen-voice-input.env (do NOT commit the real file).
#
# Remote (DashScope OpenAI-compatible):
# QWEN_VOICE_BACKEND=dashscope_openai
# DASHSCOPE_API_KEY=YOUR_KEY_HERE
# QWEN_VOICE_REMOTE_MODEL=qwen3-asr-flash
# QWEN_VOICE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VOICE_LANGUAGE=zh
# QWEN_VOICE_ENABLE_ITN=1
#
# Local (default):
# QWEN_VOICE_BACKEND=local
#
# Input injection (no clipboard):
# QWEN_VOICE_GUI_INPUT_MODE=auto
